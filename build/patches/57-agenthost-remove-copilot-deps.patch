+		envelope = {
+			type: 'error',
+			error: {
+				type: 'api_error',
+				message: bodyText || `${status} ${statusText}`,
+			},
+			request_id: null,
+		};
+	}
+	return new CopilotApiError(
+		status,
+		envelope,
+		`${prefix}: ${status} ${statusText} \u2014 ${envelope.error.message}`,
+	);
