+import type { ILocalModelSetupService } from '../copilot/localModelBridge/localModelSetupTypes.js';
+import type { LocalModelProviderSelection } from '../copilot/localModelBridge/localModelProvider.js';
+import type { CCAModel, ICopilotApiService, ICopilotApiServiceRequestOptions, ICopilotUtilityChatCompletionRequest, IRestrictedTelemetryContext } from './copilotApiTypes.js';
+
+/**
+ * {@link ICopilotApiService} for builds that ship without `@vscode/copilot-api`.
+ *
+ * The Agent Host service collection still needs a binding for the DI seam, but the Copilot-backed
+ * {@link CopilotApiService} cannot even be loaded when the package is absent. Every call rejects with the same
+ * actionable message; the seam and its interface stay intact, so a non-Copilot backend can be dropped in later
+ * without touching consumers.
+ */
+export class NoCopilotApiService implements ICopilotApiService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private _unavailable(method: string): Error {
+		return new Error(`[agentHost] ${method} is unavailable: this build ships without the Copilot API.`);
+	}
+
+	messages(_githubToken: string, _request: any, _options?: ICopilotApiServiceRequestOptions): any {
+		return Promise.reject(this._unavailable('messages'));
+	}
+
+	countTokens(_githubToken: string, _req: any, _options?: ICopilotApiServiceRequestOptions): Promise<any> {
+		return Promise.reject(this._unavailable('countTokens'));
+	}
+
+	models(_githubToken: string, _options?: ICopilotApiServiceRequestOptions): Promise<CCAModel[]> {
+		return Promise.reject(this._unavailable('models'));
+	}
+
+	responses(_githubToken: string, _body: string, _options?: ICopilotApiServiceRequestOptions): Promise<Response> {
+		return Promise.reject(this._unavailable('responses'));
+	}
+
+	utilityChatCompletion(_githubToken: string, _request: ICopilotUtilityChatCompletionRequest, _options?: ICopilotApiServiceRequestOptions): Promise<string> {
+		return Promise.reject(this._unavailable('utilityChatCompletion'));
+	}
+
+	resolveRestrictedTelemetryContext(_githubToken: string): Promise<IRestrictedTelemetryContext> {
+		return Promise.reject(this._unavailable('resolveRestrictedTelemetryContext'));
+	}
+
+	resolveApiEndpoint(_githubToken: string): Promise<string | undefined> {
+		return Promise.reject(this._unavailable('resolveApiEndpoint'));
+	}
+}
+
+/**
+ * {@link ILocalModelSetupService} for builds that ship without `@github/copilot-sdk`.
+ *
+ * On-device models are served by the Copilot SDK shim, which this build cannot load, so no host owns a provider and
+ * the local model status stays withdrawn — the behaviour {@link NullLocalModelSetupService} describes for remote
+ * hosts.
+ */
+export class NoLocalModelSetupService implements ILocalModelSetupService {
+
+	declare readonly _serviceBrand: undefined;
+	readonly isLocalAgentHost = false;
+	readonly provider = undefined;
+
+	applySelection(_selection: LocalModelProviderSelection): undefined {
+		return undefined;
+	}
+}
